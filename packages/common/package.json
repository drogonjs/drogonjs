{
  "name": "@drogonjs/common",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": ["./dist/index.js"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external reflect-metadata && bunx tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "openapi-types": "^12.1.3",
    "typescript": "^5.9.2"
  }
}