    "test": "bun test"
  },
  "dependencies": {
    "@drogonjs/common": "^0.2.0"
  },
  "devDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "typescript": "^5.9.2"
  }
}