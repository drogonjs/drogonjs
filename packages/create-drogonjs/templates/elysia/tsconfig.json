{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Required by DrogonJS. Without these two flags Bun and tsc fall back to
    // stage-3 decorators, and every method or parameter decorator silently
    // stops registering metadata — routes vanish and injection breaks.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["bun"]
  },
  "include": ["src", "test"]
}
