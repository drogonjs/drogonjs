{
  "name": "@drogonjs/openapi",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external @drogonjs/common --external @elysia/openapi --external openapi-types --external elysia && bunx tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@drogonjs/common": "^0.1.0",
    "@elysia/openapi": "^1.4.3",
    "openapi-types": "^12.1.3"
  },
  "peerDependencies": {
    "elysia": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
